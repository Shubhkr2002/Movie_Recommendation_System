# Copy this file to .env and fill in real values. Never commit the real .env.

# Required - get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional - app metadata
APP_NAME=Movie Recommendation API
API_VERSION=1.0
DEBUG=false

# Optional - logging
LOG_LEVEL=INFO

# Optional - CORS / security
# Comma-separated is NOT supported by pydantic-settings' default list parsing;
# use a JSON array string instead, e.g. ALLOWED_ORIGINS=["https://your-frontend.onrender.com"]
ALLOWED_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]

# Optional - TMDB tuning
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_TIMEOUT_SECONDS=20.0

# Optional - data file locations (relative to the app's working directory)
DATA_DIR=data
DF_FILENAME=df.pkl
INDICES_FILENAME=indices.pkl
TFIDF_MATRIX_FILENAME=tfidf_matrix.pkl
TFIDF_VECTORIZER_FILENAME=tfidf.pkl
